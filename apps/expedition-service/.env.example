# Local development configuration for expedition-service.
# Copy to .env and adjust values. Defaults match docker-compose.yml.
DATABASE_URL=postgres://postgres:password@localhost:5434/expedition_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Goose migration configuration. GOOSE_DBSTRING points at the same database
# as DATABASE_URL above.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:password@localhost:5434/expedition_db
GOOSE_MIGRATION_DIR=./sql/schema/