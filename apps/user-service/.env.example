# Local development configuration for user-service.
# Copy to .env and adjust values. Defaults match docker-compose.yml.
DATABASE_URL=postgres://postgres:password@localhost:5431/user_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# HTTP listen address for the service's API (get /health etc).
HTTP_ADDR=:8081

# Goose migration configuration. GOOSE_DBSTRING points at the same database
# as DATABASE_URL above.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:password@localhost:5431/user_db
GOOSE_MIGRATION_DIR=./sql/schema/