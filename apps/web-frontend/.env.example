# Server-only proxy targets for real local development.
#
# Copy this file to `.env.local` (gitignored) and adjust as needed. These
# variables are intentionally NOT prefixed with `VITE_`: they configure the
# Vite dev/preview server only and must never be inlined into the browser
# bundle. See `docs/specs/web-frontend.md` §7.
#
# `make dev` starts the matching local services on these defaults.
USER_SERVICE_PROXY_TARGET=http://localhost:8081
DAILY_SERVICE_PROXY_TARGET=http://localhost:8082
SHIP_SERVICE_PROXY_TARGET=http://localhost:8083
EXPEDITION_SERVICE_PROXY_TARGET=http://localhost:8084

# Browser-visible mock scenario for `npm run dev:mock` (or `.env.mock.local`).
# Defaults to `established-player` when unset. Valid names:
#   anonymous, provisioning, established-player, damaged-ship,
#   expedition-ready, active-expedition, resolved-expedition,
#   expired-session, service-outage, delayed-propagation
# VITE_MOCK_SCENARIO=established-player
