# Local development configuration for ship-service.
# Values match the local infrastructure in docker-compose.yml.
DATABASE_URL=postgres://postgres:password@localhost:5433/ship_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Goose migration configuration. GOOSE_DBSTRING points at the same database
# as DATABASE_URL above.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:password@localhost:5433/ship_db
GOOSE_MIGRATION_DIR=./sql/schema/